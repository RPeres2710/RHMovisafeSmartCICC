function deleteEmployee(id){
  const emp=employees.find(e=>e.id===id);
  if(!emp) return;
  const ok=confirm(`Excluir o funcionário "${emp.nome}"? Esta ação não pode ser desfeita.`);
  if(!ok) return;
  employees=employees.filter(e=>e.id!==id);
  atestados=atestados.filter(a=>a.emp_id!==id);
  disciplinas=disciplinas.filter(d=>d.emp_id!==id);
  if(docFiles[id]) delete docFiles[id];
  updateDashboard();
  renderEmployees();
  renderFerias();
  renderAtestados();
  renderDisciplina();
  renderEsocial();
  renderAlertas();
  saveAll();
}

