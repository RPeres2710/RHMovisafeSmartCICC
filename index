// ── PDF CONTRACT ─────────────────────────────────────────────────────────────
function handlePdfFile(file) {
  if(!file||file.type!=='application/pdf'){alert('Selecione um arquivo PDF válido.');return;}
  const r=new FileReader();
  r.onload=e=>{
    currentPdfData={name:file.name,size:file.size,dataUrl:e.target.result};
    showPdfAttached();
    saveAll();
  };
  r.readAsDataURL(file);
}
function handlePdfDrop(e) {e.preventDefault();document.getElementById('pdf-drop-zone').classList.remove('drag-over');handlePdfFile(e.dataTransfer.files[0]);}
function showPdfAttached() {
  if(!currentPdfData) return;
  document.getElementById('pdf-placeholder').style.display='none';
  document.getElementById('pdf-attached').style.display='block';
  document.getElementById('pdf-name').textContent=currentPdfData.name;
  const kb=Math.round(currentPdfData.size/1024);
  document.getElementById('pdf-size').textContent=kb<1024?kb+' KB':(kb/1024).toFixed(1)+' MB';
}
function removePdf(e) {e.stopPropagation();currentPdfData=null;document.getElementById('pdf-placeholder').style.display='';document.getElementById('pdf-attached').style.display='none';document.getElementById('pdf-input').value='';saveAll();}
function viewPdf(e) {
  e.stopPropagation();
  if(!currentPdfData||!currentPdfData.dataUrl) return;
  const w=window.open();
  if(!w) return;
  w.document.write('<iframe src="'+currentPdfData.dataUrl+'" style="width:100%;height:100%;border:none;margin:0;"></iframe>');
}

// ── DOCUMENTOS ───────────────────────────────────────────────────────────────
function docUploaded(key, input) {
  if(!input.files||!input.files[0]) return;
  const file=input.files[0];
  const empId=editingId||'__new__';
  if(!docFiles[empId]) docFiles[empId]={};
  const r=new FileReader();
  r.onload=function(e){
    docFiles[empId][key]={name:file.name,size:file.size,type:file.type,dataUrl:e.target.result};
    renderDocItem(key,empId); updateDocProgress();
    saveAll();
  };
  r.readAsDataURL(file);
}
function renderDocItem(key, empId) {
  const data=docFiles[empId]&&docFiles[empId][key];
  const badge=document.getElementById('badge-'+key);
  if(!data||!badge) return;
  badge.textContent='AOK'; badge.className='doc-badge badge-ok';
  const btn=document.getElementById('btn-'+key);
  if(!btn) return;
  const shortName=data.name.length>14?data.name.slice(0,14)+'…':data.name;
  const isImg=data.type&&data.type.startsWith('image/');
  let html='<div class="doc-actions" id="actions-'+key+'"'+(isImg?' onmouseenter="showDocHover(\''+key+'\')" onmouseleave="hideDocHover()"':'')+'>';
  html+='<span class="doc-filename" title="'+data.name+'">📎 '+shortName+'</span>';
  if(isImg) html+='<button class="doc-action-btn preview" onclick="previewDoc(\''+key+'\')">🔍 Ver</button>';
  html+='<button class="doc-action-btn open" onclick="openDoc(\''+key+'\')">↗ Abrir</button>';
  html+='<button class="doc-action-btn remove" onclick="removeDoc(\''+key+'\')">✕</button>';
  html+='</div>';
  btn.outerHTML=html;
  const docEl=document.getElementById('doc-'+key);
  if(docEl){docEl.style.background='rgba(5,150,105,.12)';setTimeout(()=>{docEl.style.background='';},1000);}
}
function previewDoc(key) {
  const empId=editingId||'__new__';
  const data=docFiles[empId]&&docFiles[empId][key];
  if(!data) return;
  document.getElementById('doc-preview-title').textContent=DOC_LABELS[key]||key;
  document.getElementById('doc-preview-img').src=data.dataUrl;
  document.getElementById('doc-preview-overlay').style.display='flex';
}
function openDoc(key) {
  const empId=editingId||'__new__';
  const data=docFiles[empId]&&docFiles[empId][key];
  if(!data||!data.dataUrl) return;
  const w=window.open();
  if(!w) return;
  // Open the data URL directly to avoid string-based HTML injection issues.
  w.location.href = data.dataUrl;
}
function removeDoc(key) {
  const empId=editingId||'__new__';
  if(docFiles[empId]) delete docFiles[empId][key];
  const actEl=document.getElementById('actions-'+key);
  if(actEl) actEl.outerHTML=`<button class="doc-upload-btn" id="btn-${key}" onclick="document.getElementById('file-${key}').click()">📎 Anexar</button>`;
  const badge=document.getElementById('badge-'+key);
  if(badge){const pri=docPriority[key];badge.textContent=pri==='opc'?'N/A':'Pendente';badge.className='doc-badge '+(pri==='imp'?'badge-imp':pri==='nec'?'badge-nec':'badge-opc');}
  const inp=document.getElementById('file-'+key); if(inp) inp.value='';
  updateDocProgress();
  saveAll();
}
function showDocHover(key){
  const empId=editingId||'__new__';
  const data=docFiles[empId]&&docFiles[empId][key];
  if(!data||!data.dataUrl) return;
  const hover=document.getElementById('doc-hover');
  const img=document.getElementById('doc-hover-img');
  if(!hover||!img) return;
  img.src=data.dataUrl;
  hover.style.display='block';
}
function hideDocHover(){
  const hover=document.getElementById('doc-hover');
  if(hover) hover.style.display='none';
}
document.addEventListener('mousemove', (e)=>{
  const hover=document.getElementById('doc-hover');
  if(!hover||hover.style.display!=='block') return;
  // Auto-hide when no doc-actions is hovered anymore.
  if(!document.querySelector('.doc-actions:hover')) { hideDocHover(); return; }
  const pad=14;
  let x=e.clientX+pad, y=e.clientY+pad;
  if(x+240>window.innerWidth) x=e.clientX-240;
  if(y+160>window.innerHeight) y=e.clientY-160;
  hover.style.left=x+'px';
  hover.style.top=y+'px';
});
document.addEventListener('scroll', hideDocHover, true);
document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') hideDocHover(); });
function updateDocProgress() {
  const empId=editingId||'__new__';
  const uploaded=docFiles[empId]?Object.keys(docFiles[empId]).length:0;
  const pct=Math.round(uploaded/docKeys.length*100);
  const fill=document.getElementById('doc-progress-fill');
  const label=document.getElementById('doc-progress-text');
  if(fill) fill.style.width=pct+'%';
  if(label) label.textContent=uploaded+' / '+docKeys.length;
}

function saveAll(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify({employees,atestados,disciplinas,docFiles}));
  }catch(e){}
}
function resetDocTab() {
  const empId=editingId||'__new__';
  docKeys.forEach(key=>{
    const actEl=document.getElementById('actions-'+key);
    if(actEl) actEl.outerHTML=`<button class="doc-upload-btn" id="btn-${key}" onclick="document.getElementById('file-${key}').click()">📎 Anexar</button>`;
    const badge=document.getElementById('badge-'+key);
    const inp=document.getElementById('file-'+key);
    if(inp) inp.value='';
    if(badge){const pri=docPriority[key];badge.textContent=pri==='opc'?'N/A':'Pendente';badge.className='doc-badge '+(pri==='imp'?'badge-imp':pri==='nec'?'badge-nec':'badge-opc');}
  });
  if(docFiles[empId]){Object.keys(docFiles[empId]).forEach(key=>renderDocItem(key,empId));}
  updateDocProgress();
}

// ── HELPERS ──────────────────────────────────────────────────────────────────
const avatarColors=['#2563eb','#7c3aed','#059669','#b45309','#be185d','#dc2626','#0891b2','#65a30d','#d97706','#7e22ce'];
function avatarColor(n){let h=0;for(let c of n)h=(h+c.charCodeAt(0))%avatarColors.length;return avatarColors[h];}
function initials(n){return n.split(' ').filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase();}
function empAvatar(emp){
  const src = (emp.foto && typeof emp.foto === 'string' && emp.foto.startsWith('data:')) ? emp.foto : '';
  if(src) return `<div class="emp-avatar"><img src="${src}" style="width:100%;height:100%;object-fit:cover;border-radius:50%"></div>`;
  return `<div class="emp-avatar" style="background:${avatarColor(emp.nome)}">${initials(emp.nome)}</div>`;
}
function empresaBadge(emp){return emp.empresa==='Movisafe'?'<span class="badge badge-movisafe">🛡 Movisafe</span>':'<span class="badge badge-smartcicc">🖥 Smart CICC</span>';}
function statusBadge(s){
  if(s==='Ativo') return'<span class="badge badge-ativo">✅ Ativo</span>';
  if(s==='Em Férias') return'<span class="badge badge-ferias">🌴 Em Férias</span>';
  if(s==='Afastado') return'<span class="badge badge-afastado">🩺 Afastado</span>';
  if(s==='Experiência') return'<span class="badge badge-experiencia">🧪 Experiência</span>';
  return`<span class="badge" style="background:rgba(100,116,139,.15);color:var(--text3)">${s}</span>`;
}
function fmtDate(d){if(!d)return'—';const p=d.split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:d;}

// ── RENDER EMPLOYEES ──────────────────────────────────────────────────────────
function filterTab(btn, empresa) {
  document.querySelectorAll('.ftab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); filterEmpresa=empresa; renderEmployees();
}
function filterEmployees(){renderEmployees(document.getElementById('search-input').value.toLowerCase());}
function renderEmployees(q='') {
  const tbody=document.getElementById('emp-table-rows');
  let list=employees.filter(e=>e.status!=='Desligado');
  if(filterEmpresa!=='todos') list=list.filter(e=>e.empresa===filterEmpresa);
  if(q) list=list.filter(e=>e.nome.toLowerCase().includes(q)||(e.cargo||'').toLowerCase().includes(q)||(e.cpf||'').includes(q));
  if(!list.length){tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text3)">Nenhum funcionário encontrado</td></tr>';return;}
  tbody.innerHTML=list.map(emp=>`<tr>
    <td><div class="emp-info">${empAvatar(emp)}<div><div class="emp-name">${emp.nome}</div><div class="emp-role">${emp.cargo}</div></div></div></td>
    <td>${empresaBadge(emp)}</td>
    <td style="font-size:12px;color:var(--text2)">${emp.setor||'—'}</td>
    <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.admissao)}</td>
    <td>${emp.esocial_status==='Incluído'?'<span style="color:var(--green);font-size:12px">✅ Incluído</span>':emp.esocial_status==='Pendente'?'<span style="color:var(--amber);font-size:12px">⏳ Pendente</span>':'<span style="color:var(--red);font-size:12px">❌ Erro</span>'}</td>
    <td>${statusBadge(emp.status)}</td>
    <td>
      <button class="action-btn" onclick="openModal('edit',${emp.id})">✏️ Editar</button>
      <button class="action-btn danger" onclick="deleteEmployee(${emp.id})">🗑 Excluir</button>
    </td>
  </tr>`).join('');
}

// ── RENDER FÉRIAS ─────────────────────────────────────────────────────────────
function renderFerias() {
  const today=new Date(); let prog=0,gozo=0,gozadas=0,atrasadas=0;
  const tbody=document.getElementById('ferias-rows');
  tbody.innerHTML=employees.filter(e=>e.status!=='Desligado').map(emp=>{
    const adm=emp.admissao?new Date(emp.admissao):null;
    const meses=adm?Math.floor((today-adm)/(1000*60*60*24*30)):0;
    const diasDir=meses>=12?30:0;
    const gozado=emp.ferias_gozadas||0;
    const saldo=Math.max(0,diasDir-gozado);
    const pct=diasDir>0?Math.min(100,Math.round(gozado/diasDir*100)):0;
    let sit='—',sitC='';
    if(emp.ferias_status==='Atrasado'){sit='⚠️ Vencidas';sitC='color:var(--red)';atrasadas++;}
    else if(emp.ferias_status==='Em gozo'){sit='🌴 Em Gozo';sitC='color:var(--amber)';gozo++;}
    else if(emp.ferias_status==='Programado'){sit='📅 Programado';sitC='color:var(--accent)';prog++;}
    else if(emp.ferias_status==='Concluído'){sit='✅ Concluída';sitC='color:var(--green)';gozadas++;}
    return`<tr>
      <td><div class="emp-info">${empAvatar(emp)}<div class="emp-name">${emp.nome}</div></div></td>
      <td>${empresaBadge(emp)}</td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.admissao)}</td>
      <td style="font-family:'Outfit';font-weight:700;color:var(--accent)">${diasDir}</td>
      <td><div style="font-size:13px;font-weight:500">${gozado} dias</div><div class="ferias-bar-wrap"><div class="ferias-bar" style="width:${pct}%"></div></div><div style="font-size:10px;color:var(--text3);margin-top:2px">${pct}%</div></td>
      <td style="font-family:'Outfit';font-weight:700;color:${saldo>0?'var(--amber)':'var(--green)'}">${saldo}</td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.ferias_inicio)||'—'}</td>
      <td><span style="${sitC};font-size:12px;font-weight:600">${sit}</span></td>
    </tr>`;
  }).join('');
  document.getElementById('f-programadas').textContent=prog;
  document.getElementById('f-gozo').textContent=gozo;
  document.getElementById('f-gozadas').textContent=gozadas;
  document.getElementById('f-atrasadas').textContent=atrasadas;
}

// ── RENDER ATESTADOS ──────────────────────────────────────────────────────────
function renderAtestados() {
  const tbody=document.getElementById('atestados-rows');
  const totalDias=atestados.reduce((s,a)=>s+a.dias,0);
  const hoje=new Date().toISOString().slice(0,7);
  document.getElementById('at-total').textContent=atestados.length;
  document.getElementById('at-dias').textContent=totalDias;
  document.getElementById('at-mes').textContent=atestados.filter(a=>a.data.startsWith(hoje)).length;
  if(!atestados.length){tbody.innerHTML='<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text3)">Nenhum atestado registrado</td></tr>';return;}
  tbody.innerHTML=atestados.map(at=>{
    const emp=employees.find(e=>e.id===at.emp_id); if(!emp) return'';
    return`<tr>
      <td><div class="emp-info">${empAvatar(emp)}<div class="emp-name">${emp.nome}</div></div></td>
      <td>${empresaBadge(emp)}</td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(at.data)}</td>
      <td><span style="background:rgba(37,99,235,.1);color:var(--accent);padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600">${at.cid||'—'}</span></td>
      <td><span style="font-family:'Outfit';font-weight:700;color:var(--amber);font-size:16px">${at.dias}</span></td>
      <td style="font-size:12px;color:var(--text2)">${at.medico||'—'}</td>
      <td style="font-size:12px;color:var(--text2)">${at.hospital||'—'}</td>
      <td>${at.status==='Validado'?'<span style="color:var(--green);font-size:12px;font-weight:600">✅ Validado</span>':'<span style="color:var(--amber);font-size:12px;font-weight:600">⏳ Em análise</span>'}</td>
    </tr>`;
  }).join('');
}

// ── RENDER DISCIPLINA ─────────────────────────────────────────────────────────
function renderDisciplina() {
  const tbody=document.getElementById('disciplina-rows');
  document.getElementById('d-advertencias').textContent=disciplinas.filter(d=>d.tipo.includes('Advertência')).length;
  document.getElementById('d-suspensoes').textContent=disciplinas.filter(d=>d.tipo==='Suspensão').length;
  document.getElementById('d-avaliacoes').textContent=disciplinas.filter(d=>d.tipo.includes('Avaliação')).length;
  document.getElementById('d-elogios').textContent=disciplinas.filter(d=>d.tipo==='Elogio').length;
  if(!disciplinas.length){tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text3)">Nenhum registro disciplinar</td></tr>';return;}
  tbody.innerHTML=disciplinas.map(d=>{
    const emp=employees.find(e=>e.id===d.emp_id); if(!emp) return'';
    const c=d.tipo.includes('Advertência')?'var(--amber)':d.tipo==='Suspensão'?'var(--red)':d.tipo==='Elogio'?'var(--green)':'var(--accent)';
    return`<tr>
      <td><div class="emp-info">${empAvatar(emp)}<div class="emp-name">${emp.nome}</div></div></td>
      <td>${empresaBadge(emp)}</td>
      <td><span style="color:${c};font-size:12px;font-weight:600">${d.tipo}</span></td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(d.data)}</td>
      <td style="font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${d.motivo}</td>
      <td style="font-size:12px;color:var(--text2)">${d.responsavel||'—'}</td>
      <td style="font-size:14px">${d.nota?'⭐'.repeat(parseInt(d.nota)):'—'}</td>
    </tr>`;
  }).join('');
}

// ── RENDER E-SOCIAL ───────────────────────────────────────────────────────────
function renderEsocial() {
  const tbody=document.getElementById('esocial-rows');
  tbody.innerHTML=employees.filter(e=>e.status!=='Desligado').map(emp=>{
    let sit='';
    if(emp.esocial_status==='Incluído') sit='<div class="esocial-status" style="margin-bottom:0"><div class="dot dot-green"></div><span style="font-size:12px;color:var(--green);font-weight:600">✅ Incluído</span></div>';
    else if(emp.esocial_status==='Pendente') sit='<div class="esocial-status" style="margin-bottom:0"><div class="dot dot-amber"></div><span style="font-size:12px;color:var(--amber);font-weight:600">⏳ Pendente</span></div>';
    else sit='<div class="esocial-status" style="margin-bottom:0"><div class="dot dot-red-s"></div><span style="font-size:12px;color:var(--red);font-weight:600">❌ Erro</span></div>';
    return`<tr>
      <td><div class="emp-info">${empAvatar(emp)}<div><div class="emp-name">${emp.nome}</div><div class="emp-role">${emp.cargo}</div></div></div></td>
      <td>${empresaBadge(emp)}</td>
      <td style="font-size:12px;color:var(--text2);font-family:monospace">${emp.cpf||'—'}</td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.admissao)}</td>
      <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.esocial)||'—'}</td>
      <td>${sit}</td>
    </tr>`;
  }).join('');
}

// ── DASHBOARD ──────────────────────────────────────────────────────────────────
function updateDashboard() {
  const total=employees.filter(e=>e.status!=='Desligado');
  document.getElementById('cnt-movisafe').textContent=total.filter(e=>e.empresa==='Movisafe').length;
  document.getElementById('cnt-smartcicc').textContent=total.filter(e=>e.empresa==='Smart CICC').length;
  document.getElementById('cnt-experiencia').textContent=total.filter(e=>e.status==='Experiência').length;
  document.getElementById('cnt-total').textContent=total.length;
  const T=total.length||1;
  const a=total.filter(e=>e.status==='Ativo').length;
  const f=total.filter(e=>e.status==='Em Férias').length;
  const af=total.filter(e=>e.status==='Afastado').length;
  const ex=total.filter(e=>e.status==='Experiência').length;
  ['ativos','ferias','afastados','exp'].forEach((k,i)=>{
    const v=[a,f,af,ex][i];
    const el=document.getElementById('dash-'+k);
    const bar=document.getElementById('bar-'+k);
    if(el) el.textContent=v;
    if(bar) bar.style.width=(v/T*100)+'%';
  });
  const atr=employees.filter(e=>e.ferias_status==='Atrasado');
  document.getElementById('alerta-ferias-atrasadas').textContent=atr.length?atr.map(e=>e.nome.split(' ')[0]).join(', ')+' têm férias vencidas':'Nenhuma pendência ✅';
  const exp=employees.filter(e=>e.status==='Experiência');
  document.getElementById('alerta-experiencia').textContent=exp.length?exp.map(e=>e.nome.split(' ')[0]).join(', ')+' em período de experiência':'Nenhum em experiência';
  const prog=employees.filter(e=>e.ferias_status==='Programado');
  document.getElementById('alerta-ferias-prog').textContent=prog.length?prog.map(e=>e.nome.split(' ')[0]).join(', ')+' com férias programadas':'Nenhuma programada';
  const pend=employees.filter(e=>e.esocial_status==='Pendente');
  document.getElementById('alerta-esocial').textContent=pend.length?pend.map(e=>e.nome.split(' ')[0]).join(', ')+' pendentes de inclusão':'Todos incluídos ✅';

  // update alert badge
  const totalAlerts = atr.length + exp.length + pend.length;
  const badge = document.getElementById('alert-badge-count');
  if(badge) badge.textContent = totalAlerts;

  const rec=[...total].sort((a,b)=>b.admissao>a.admissao?1:-1).slice(0,6);
  document.getElementById('dash-recent-rows').innerHTML=rec.map(emp=>`<tr>
    <td><div class="emp-info">${empAvatar(emp)}<div><div class="emp-name">${emp.nome}</div><div class="emp-role">${emp.cargo}</div></div></div></td>
    <td>${empresaBadge(emp)}</td>
    <td style="font-size:12px;color:var(--text2)">${emp.cargo}</td>
    <td style="font-size:12px;color:var(--text2)">${fmtDate(emp.admissao)}</td>
    <td>${statusBadge(emp.status)}</td>
  </tr>`).join('');
}

// ── ALERTAS ───────────────────────────────────────────────────────────────────
function renderAlertas() {
  const div=document.getElementById('alertas-content');
  const list=[];
  employees.filter(e=>e.status!=='Desligado').forEach(emp=>{
    if(emp.ferias_status==='Atrasado') list.push({t:'error',i:'⚠️',title:`Férias vencidas — ${emp.nome}`,sub:`${emp.empresa} · Admissão: ${fmtDate(emp.admissao)}`});
    if(emp.status==='Experiência'&&emp.fim_experiencia){
      const dias=Math.ceil((new Date(emp.fim_experiencia)-new Date())/(1000*60*60*24));
      list.push({t:'warn',i:'🧪',title:`Experiência encerrando em ${dias} dia(s) — ${emp.nome}`,sub:`${emp.empresa} · Término: ${fmtDate(emp.fim_experiencia)}`});
    }
    if(emp.esocial_status==='Pendente') list.push({t:'success',i:'📋',title:`e-Social pendente — ${emp.nome}`,sub:`${emp.empresa} · Admissão: ${fmtDate(emp.admissao)}`});
    if(emp.ferias_status==='Programado') list.push({t:'info',i:'🌴',title:`Férias programadas — ${emp.nome}`,sub:`${emp.empresa} · Início: ${fmtDate(emp.ferias_inicio)}`});
    if(emp.status==='Afastado') list.push({t:'warn',i:'🩺',title:`Funcionário afastado — ${emp.nome}`,sub:`${emp.empresa} · ${emp.obs||'Afastamento médico'}`});
  });
  if(!list.length){div.innerHTML='<div class="empty-state"><div class="empty-icon">🎉</div><div style="font-size:14px">Nenhum alerta pendente!</div></div>';return;}
  div.innerHTML=list.map(a=>`<div class="notif notif-${a.t}"><div class="notif-icon">${a.i}</div><div class="notif-body"><div class="notif-title">${a.title}</div><div class="notif-sub">${a.sub}</div></div></div>`).join('');
}

// ── DARK MODE ─────────────────────────────────────────────────────────────────
function toggleDark() {
  document.body.classList.toggle('dark');
  const isDark=document.body.classList.contains('dark');
  document.getElementById('dark-toggle').classList.toggle('on',isDark);
  document.getElementById('theme-label').textContent=isDark?'Escuro':'Claro';
  try{localStorage.setItem('rh-theme',isDark?'dark':'light');}catch(e){}
}
(function(){try{if(localStorage.getItem('rh-theme')==='dark'){document.body.classList.add('dark');}}catch(e){}})();

// ── INIT ──────────────────────────────────────────────────────────────────────
updateDashboard();
renderEmployees();
</script>
