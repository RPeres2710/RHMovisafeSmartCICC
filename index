<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Central RH — Movisafe</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#eef2f8; --surface:#fff; --surface2:#f4f7fc; --surface3:#e8edf7;
  --border:#d8e0ef; --accent:#2563eb; --accent2:#3b82f6;
  --green:#059669; --amber:#b45309; --red:#dc2626; --purple:#7c3aed; --pink:#be185d;
  --movisafe:#2563eb; --smartcicc:#7c3aed;
  --text:#0f172a; --text2:#475569; --text3:#94a3b8;
  --radius:12px; --radius-sm:8px;
  --shadow:0 1px 3px rgba(15,23,42,.06),0 4px 12px rgba(15,23,42,.08);
  --sidebar-bg:#1e293b; --sidebar-text:rgba(255,255,255,.65); --sidebar-border:rgba(255,255,255,.1);
}
body.dark {
  --bg:#0b0f1a; --surface:#111827; --surface2:#1a2236; --surface3:#222d42;
  --border:#2a3a56; --accent:#3b82f6; --accent2:#60a5fa;
  --green:#10b981; --amber:#f59e0b; --red:#ef4444; --purple:#8b5cf6;
  --text:#e2e8f0; --text2:#94a3b8; --text3:#64748b;
  --shadow:0 2px 8px rgba(0,0,0,.4);
  --sidebar-bg:#0d1424;
}
body.dark .badge-movisafe{background:rgba(59,130,246,.2);color:#93c5fd}
body.dark .badge-smartcicc{background:rgba(139,92,246,.2);color:#c4b5fd}
body.dark .badge-ativo{background:rgba(16,185,129,.2);color:#6ee7b7}
body.dark .badge-ferias{background:rgba(245,158,11,.2);color:#fcd34d}
body.dark .badge-afastado{background:rgba(239,68,68,.2);color:#fca5a5}
body.dark .badge-experiencia{background:rgba(236,72,153,.2);color:#f9a8d4}
body.dark tr:hover td{background:#1e2d48}
body.dark td{border-bottom-color:rgba(42,58,86,.5)}
body.dark .notif-warn{background:rgba(245,158,11,.1);border-color:rgba(245,158,11,.25)}
body.dark .notif-info{background:rgba(59,130,246,.1);border-color:rgba(59,130,246,.25)}
body.dark .notif-error{background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.25)}
body.dark .notif-success{background:rgba(16,185,129,.1);border-color:rgba(16,185,129,.25)}
body.dark .doc-action-btn.preview{background:rgba(59,130,246,.1)}
body.dark .doc-action-btn.open{background:rgba(16,185,129,.1)}
body.dark .doc-action-btn.remove{background:var(--surface2)}
body.dark .badge-imp{background:rgba(220,38,38,.2);color:#fca5a5}
body.dark .badge-nec{background:rgba(37,99,235,.2);color:#93c5fd}
body.dark .badge-opc{background:rgba(5,150,105,.2);color:#6ee7b7}
body.dark .badge-ok{background:rgba(5,150,105,.2);color:#6ee7b7}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);overflow:hidden}
#app{display:flex;height:100vh}

/* SIDEBAR */
#sidebar{width:240px;min-width:240px;background:var(--sidebar-bg);display:flex;flex-direction:column;overflow:hidden;box-shadow:2px 0 12px rgba(15,23,42,.12)}
.logo-bar{padding:20px 20px 16px;border-bottom:1px solid var(--sidebar-border)}
.logo-title{font-family:'Outfit',sans-serif;font-weight:800;font-size:18px;color:#fff;letter-spacing:-.5px}
.logo-sub{font-size:11px;color:rgba(255,255,255,.4);margin-top:2px;letter-spacing:1px;text-transform:uppercase}
.nav-section{padding:12px 12px 4px;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.35);font-weight:600}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;margin:1px 8px;border-radius:var(--radius-sm);cursor:pointer;font-size:13.5px;color:var(--sidebar-text);transition:.15s}
.nav-item:hover{background:rgba(255,255,255,.08);color:#fff}
.nav-item.active{background:var(--accent);color:#fff}
.nav-item .icon{font-size:16px;width:20px;text-align:center}
.sidebar-footer{margin-top:auto;padding:12px;border-top:1px solid var(--sidebar-border)}
.badge-count{margin-left:auto;background:var(--red);color:#fff;font-size:10px;padding:1px 6px;border-radius:20px;font-weight:700}

/* MAIN */
#main{flex:1;display:flex;flex-direction:column;overflow:hidden}
#topbar{height:56px;border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:16px;background:var(--surface);box-shadow:0 1px 4px rgba(15,23,42,.06)}
.topbar-title{font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;flex:1}
.search-box{display:flex;align-items:center;gap:8px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px 12px;width:260px}
.search-box input{background:none;border:none;outline:none;color:var(--text);font-size:13px;width:100%;font-family:'Plus Jakarta Sans',sans-serif}
.search-box input::placeholder{color:var(--text3)}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--radius-sm);border:none;cursor:pointer;font-size:13px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:500;transition:.15s}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent2)}
.btn-ghost{background:var(--surface2);color:var(--text2);border:1px solid var(--border)}
.btn-ghost:hover{color:var(--text);background:var(--surface3)}

#content{flex:1;overflow-y:auto;padding:24px}
#content::-webkit-scrollbar{width:4px}
#content::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.page{display:none}.page.active{display:block}

/* CARDS */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;box-shadow:var(--shadow)}
.stat-label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--text3);font-weight:600}
.stat-value{font-family:'Outfit',sans-serif;font-size:32px;font-weight:800;margin:6px 0 2px}
.stat-sub{font-size:12px;color:var(--text3)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.card-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.card-title{font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;flex:1}
.filter-tabs{display:flex;gap:4px;flex-wrap:wrap}
.ftab{padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid var(--border);color:var(--text2);background:transparent;transition:.15s;font-family:'Plus Jakarta Sans',sans-serif}
.ftab.active,.ftab.movisafe.active{background:var(--movisafe);border-color:var(--movisafe);color:#fff}
.ftab.smartcicc.active{background:var(--smartcicc);border-color:var(--smartcicc);color:#fff}
table{width:100%;border-collapse:collapse}
th{padding:10px 16px;text-align:left;font-size:11px;letter-spacing:.8px;text-transform:uppercase;color:var(--text3);font-weight:600;border-bottom:1px solid var(--border);white-space:nowrap}
td{padding:12px 16px;font-size:13px;border-bottom:1px solid var(--border)}
body:not(.dark) td{border-bottom-color:#eef2f8}
tr:hover td{background:#f0f5ff}
tr:last-child td{border-bottom:none}
.emp-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;color:#fff;overflow:hidden;flex-shrink:0}
.emp-info{display:flex;align-items:center;gap:10px}
.emp-name{font-weight:500;white-space:nowrap}
.emp-role{font-size:11px;color:var(--text3);white-space:nowrap}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
.badge-movisafe{background:#dbeafe;color:#1d4ed8}
.badge-smartcicc{background:#ede9fe;color:#6d28d9}
.badge-ativo{background:#d1fae5;color:#065f46}
.badge-ferias{background:#fef3c7;color:#92400e}
.badge-afastado{background:#fee2e2;color:#991b1b}
.badge-experiencia{background:#fce7f3;color:#9d174d}
.action-btn{padding:5px 10px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid var(--border);color:var(--text2);background:transparent;font-family:'Plus Jakarta Sans',sans-serif;transition:.15s}
.action-btn:hover{border-color:var(--accent);color:var(--accent)}
.action-btn.danger{border-color:rgba(220,38,38,.35);color:var(--red)}
.action-btn.danger:hover{border-color:var(--red);color:#fff;background:var(--red)}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:100;align-items:center;justify-content:center;backdrop-filter:blur(6px)}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:900px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(15,23,42,.2)}
.modal::-webkit-scrollbar{width:4px}
.modal::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.modal-header{padding:20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.modal-title{font-family:'Outfit',sans-serif;font-weight:800;font-size:18px;flex:1}
.modal-close{background:none;border:none;color:var(--text2);cursor:pointer;font-size:20px;padding:4px}
.modal-body{padding:24px}
.tab-bar{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:20px;overflow-x:auto}
.tab-btn{padding:10px 16px;font-size:13px;cursor:pointer;border:none;background:none;color:var(--text3);font-family:'Plus Jakarta Sans',sans-serif;border-bottom:2px solid transparent;transition:.15s;margin-bottom:-1px;white-space:nowrap}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}
.tab-content{display:none}.tab-content.active{display:block}

/* FORM */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-full{grid-column:1/-1}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group label{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--text3);font-weight:600}
.form-group input,.form-group select,.form-group textarea{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;color:var(--text);font-size:13px;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:.15s}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--accent)}
.form-group select option{background:var(--surface2)}
.form-group textarea{resize:vertical;min-height:80px}
.section-title{font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;color:var(--accent);text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:1px solid var(--border);margin:20px 0 16px;grid-column:1/-1}

/* PHOTO */
.photo-upload{width:90px;height:115px;border-radius:6px;border:2px dashed var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:.15s;background:var(--surface2);overflow:hidden;position:relative}
.photo-upload:hover{border-color:var(--accent);background:#eff6ff}
.photo-upload img{width:100%;height:100%;object-fit:cover;object-position:top center;position:absolute;top:0;left:0}
.photo-upload-hint{font-size:10px;color:var(--text3);text-align:center;margin-top:6px;line-height:1.4}
.photo-area{display:flex;flex-direction:column;align-items:center;gap:6px}

/* PDF DROP */
.pdf-drop-zone{border:2px dashed var(--border);border-radius:var(--radius);padding:24px;text-align:center;cursor:pointer;transition:.2s;background:var(--surface2);min-height:90px;display:flex;align-items:center;justify-content:center;grid-column:1/-1}
.pdf-drop-zone:hover,.pdf-drop-zone.drag-over{border-color:var(--accent);background:#eff6ff}

/* DOCUMENTOS DE ADMISSÃO */
.doc-section-header{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;font-weight:700;padding:6px 0;margin-top:16px;margin-bottom:4px;border-bottom:2px solid var(--border);display:flex;align-items:center;gap:6px}
.doc-section-header:first-of-type{margin-top:0}
.doc-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface2);margin-bottom:5px;transition:.15s}
.doc-item:hover{background:var(--surface3)}
.doc-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.dot-red{background:#dc2626}.dot-blue{background:#2563eb}.dot-green-doc{background:#059669}
.doc-name{flex:1;font-size:12.5px;line-height:1.4}
.doc-name.bold{font-weight:600;color:var(--text)}
.doc-name.normal{color:var(--text2)}
.doc-name.soft{color:var(--text3)}
.doc-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;flex-shrink:0;white-space:nowrap}
.badge-imp{background:#fee2e2;color:#991b1b}
.badge-nec{background:#dbeafe;color:#1d4ed8}
.badge-opc{background:#d1fae5;color:#065f46}
.badge-ok{background:#d1fae5;color:#065f46}
.doc-upload-btn{font-size:11px;padding:4px 10px;border-radius:6px;cursor:pointer;flex-shrink:0;border:1px solid var(--border);background:var(--surface);color:var(--text2);font-family:'Plus Jakarta Sans',sans-serif;font-weight:500;transition:.15s;white-space:nowrap}
.doc-upload-btn:hover{border-color:var(--accent);color:var(--accent);background:#eff6ff}
.doc-legend{display:flex;gap:14px;flex-wrap:wrap;padding:10px 12px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:14px;border:1px solid var(--border)}
.doc-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text3)}
.doc-progress-bar{height:6px;border-radius:4px;background:var(--border);overflow:hidden;margin-bottom:14px}
.doc-progress-fill{height:100%;border-radius:4px;background:var(--green);transition:.4s}
.doc-progress-label{font-size:11px;color:var(--text3);margin-bottom:6px;display:flex;justify-content:space-between}
.doc-actions{display:flex;align-items:center;gap:5px;flex-wrap:nowrap}
.doc-filename{font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;max-width:110px;text-overflow:ellipsis}
.doc-action-btn{font-size:11px;padding:4px 9px;border-radius:6px;cursor:pointer;flex-shrink:0;white-space:nowrap;font-family:'Plus Jakarta Sans',sans-serif;font-weight:500;transition:.15s;border:1px solid}
.doc-action-btn.preview{border-color:var(--accent);color:var(--accent);background:rgba(37,99,235,.07)}
.doc-action-btn.preview:hover{background:rgba(37,99,235,.15)}
.doc-action-btn.open{border-color:var(--green);color:var(--green);background:rgba(5,150,105,.07)}
.doc-action-btn.open:hover{background:rgba(5,150,105,.15)}
.doc-action-btn.remove{border-color:var(--border);color:var(--text3);background:var(--surface)}
.doc-action-btn.remove:hover{border-color:var(--red);color:var(--red)}
.doc-hover{
  position:fixed; z-index:220; pointer-events:none; display:none;
  width:220px; height:140px; background:#111; border-radius:8px;
  box-shadow:0 10px 30px rgba(0,0,0,.35); overflow:hidden;
}
.doc-hover img{width:100%;height:100%;object-fit:contain;display:block}

/* NOTIFS */
.notif{display:flex;align-items:flex-start;gap:10px;padding:12px;border-radius:var(--radius-sm);margin-bottom:8px}
.notif-warn{background:#fffbeb;border:1px solid #fde68a}
.notif-info{background:#eff6ff;border:1px solid #bfdbfe}
.notif-error{background:#fef2f2;border:1px solid #fecaca}
.notif-success{background:#ecfdf5;border:1px solid #a7f3d0}
.notif-icon{font-size:16px;margin-top:1px;flex-shrink:0}
.notif-body{flex:1}
.notif-title{font-size:13px;font-weight:500}
.notif-sub{font-size:11px;color:var(--text3);margin-top:2px}

/* FERIAS BAR */
.ferias-bar-wrap{background:var(--surface3);border-radius:8px;overflow:hidden;height:8px;margin-top:4px}
.ferias-bar{height:100%;border-radius:8px;background:var(--green);transition:.3s}

/* ESOCIAL */
.esocial-status{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:8px;border:1px solid var(--border)}
.dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dot-green{background:var(--green)}
.dot-amber{background:var(--amber)}
.dot-red-s{background:var(--red)}

/* MISC */
.flex-row{display:flex;align-items:center;gap:12px}
.ml-auto{margin-left:auto}
.progress-mini{height:6px;background:var(--surface3);border-radius:4px;overflow:hidden;margin-top:6px}
.progress-fill{height:100%;border-radius:4px}
.empty-state{text-align:center;padding:40px;color:var(--text3)}
.empty-icon{font-size:40px;margin-bottom:12px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.three-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}

/* SETTINGS */
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}
.settings-row:last-child{border-bottom:none}
.settings-label{font-size:14px;font-weight:500}
.settings-sub{font-size:12px;color:var(--text3);margin-top:2px}
.toggle{width:44px;height:24px;background:var(--border);border-radius:20px;position:relative;cursor:pointer;transition:.25s;border:none;outline:none;flex-shrink:0}
.toggle.on{background:var(--accent)}
.toggle::after{content:'';position:absolute;width:18px;height:18px;background:#fff;border-radius:50%;top:3px;left:3px;transition:.25s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.toggle.on::after{left:23px}

::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}

/* Responsive fixes */
@media (max-width:900px){
  .two-col{grid-template-columns:1fr}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .three-col{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>
<div id="app">

<!-- SIDEBAR -->
<div id="sidebar">
  <div class="logo-bar">
    <div class="logo-title">🛡 Movisafe</div>
    <div class="logo-sub">Central de RH</div>
  </div>
  <div style="overflow-y:auto;flex:1;padding-bottom:8px;">
    <div class="nav-section">Principal</div>
    <div class="nav-item active" onclick="navTo(this,'dashboard')"><span class="icon">📊</span> Dashboard</div>
    <div class="nav-item" onclick="navTo(this,'funcionarios')"><span class="icon">👥</span> Funcionários</div>
    <div class="nav-section">Gestão</div>
    <div class="nav-item" onclick="navTo(this,'ferias')"><span class="icon">🌴</span> Férias</div>
    <div class="nav-item" onclick="navTo(this,'atestados')"><span class="icon">🏥</span> Atestados</div>
    <div class="nav-item" onclick="navTo(this,'disciplina')"><span class="icon">⚖️</span> Disciplina</div>
    <div class="nav-item" onclick="navTo(this,'esocial')"><span class="icon">📋</span> e-Social</div>
    <div class="nav-section">Empresa</div>
    <div class="nav-item" onclick="navTo(this,'relatorios')"><span class="icon">📁</span> Relatórios</div>
    <div class="nav-item" id="nav-alertas" onclick="navTo(this,'alertas')"><span class="icon">🔔</span> Alertas<span class="badge-count" id="alert-badge-count">0</span></div>
  </div>
  <div class="sidebar-footer">
    <div class="nav-item" onclick="openSettings()"><span class="icon">⚙️</span> Configurações</div>
  </div>
</div>

<!-- MAIN -->
<div id="main">
  <div id="topbar">
    <div class="topbar-title" id="page-title">Dashboard</div>
    <div class="search-box"><span>🔍</span><input type="text" placeholder="Buscar funcionário..." id="search-input" oninput="filterEmployees()"></div>
    <button class="btn btn-primary" onclick="openModal('add')">+ Novo Funcionário</button>
  </div>

  <div id="content">

    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-label">Movisafe</div><div class="stat-value" id="cnt-movisafe" style="color:var(--movisafe)">0</div><div class="stat-sub">funcionários ativos</div></div>
        <div class="stat-card"><div class="stat-label">Smart CICC</div><div class="stat-value" id="cnt-smartcicc" style="color:var(--smartcicc)">0</div><div class="stat-sub">funcionários ativos</div></div>
        <div class="stat-card"><div class="stat-label">Em Experiência</div><div class="stat-value" id="cnt-experiencia" style="color:var(--amber)">0</div><div class="stat-sub">período de 30 dias</div></div>
        <div class="stat-card"><div class="stat-label">Total Geral</div><div class="stat-value" id="cnt-total" style="color:var(--green)">0</div><div class="stat-sub">todos os vínculos</div></div>
      </div>
      <div class="two-col" style="margin-bottom:16px">
        <div class="card">
